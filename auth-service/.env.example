# Puerto donde corre el auth service
PORT=4000

# Secret compartida con el coordinator para firmar/verificar JWT
# IMPORTANTE: debe ser la misma cadena exacta que uses en coordinator/.env
# Genera una buena con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_secreto_seguro
